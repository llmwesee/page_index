AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# optional
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1


LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

LANGFUSE_ENABLED=true
ENABLE_LANGGRAPH=true

AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_KEY=${AZURE_OPENAI_API_KEY}
AZURE_OPENAI_EMBEDDING_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_OPENAI_EMBEDDING_API_VERSION=${AZURE_OPENAI_API_VERSION}

# Configure this to enable pgvector-backed routing and indexing.
# PGVECTOR_DSN=postgresql://postgres:mysecret@localhost:5432/pageindex
PGVECTOR_DSN=postgresql://postgres:mysecret@localhost:5432/pageindex

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
