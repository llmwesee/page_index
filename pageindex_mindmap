<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PageIndex — Tree Indexing & Retrieval Visualization</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Outfit:wght@300;400;600;800&display=swap');

:root {
–bg: #05070f;
–surface: #0c0f1e;
–surface2: #111530;
–border: #1e2440;
–accent: #4fffb0;
–accent2: #5c7dff;
–accent3: #ff6b6b;
–accent4: #ffd166;
–text: #d0d8f0;
–text-dim: #6070a0;
–node-index: #4fffb0;
–node-retrieval: #5c7dff;
–node-llm: #ff9a3c;
–node-answer: #c084fc;
}

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘Outfit’, sans-serif;
min-height: 100vh;
overflow-x: hidden;
}

/* Animated background grid */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image:
linear-gradient(rgba(92, 125, 255, 0.04) 1px, transparent 1px),
linear-gradient(90deg, rgba(92, 125, 255, 0.04) 1px, transparent 1px);
background-size: 48px 48px;
pointer-events: none;
z-index: 0;
}

.container {
position: relative;
z-index: 1;
max-width: 1400px;
margin: 0 auto;
padding: 40px 24px 80px;
}

/* ── HEADER ── */
header {
text-align: center;
margin-bottom: 64px;
animation: fadeDown 0.8s ease both;
}

header .badge {
display: inline-block;
background: rgba(79, 255, 176, 0.1);
border: 1px solid rgba(79, 255, 176, 0.3);
color: var(–accent);
font-family: ‘Space Mono’, monospace;
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
padding: 6px 16px;
border-radius: 100px;
margin-bottom: 20px;
}

header h1 {
font-size: clamp(36px, 6vw, 72px);
font-weight: 800;
line-height: 1.05;
background: linear-gradient(135deg, #fff 30%, #4fffb0 60%, #5c7dff 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
margin-bottom: 16px;
}

header p {
color: var(–text-dim);
font-size: 16px;
font-weight: 300;
max-width: 600px;
margin: 0 auto;
line-height: 1.7;
}

/* ── TABS ── */
.tabs {
display: flex;
justify-content: center;
gap: 8px;
margin-bottom: 48px;
flex-wrap: wrap;
animation: fadeUp 0.8s 0.2s ease both;
}

.tab-btn {
background: var(–surface);
border: 1px solid var(–border);
color: var(–text-dim);
font-family: ‘Outfit’, sans-serif;
font-size: 14px;
font-weight: 600;
padding: 10px 22px;
border-radius: 8px;
cursor: pointer;
transition: all 0.2s;
letter-spacing: 0.3px;
}

.tab-btn:hover {
border-color: var(–accent2);
color: var(–text);
}

.tab-btn.active {
background: linear-gradient(135deg, rgba(79,255,176,0.15), rgba(92,125,255,0.15));
border-color: var(–accent);
color: var(–accent);
}

.tab-panel { display: none; animation: fadeUp 0.4s ease both; }
.tab-panel.active { display: block; }

/* ── SECTION HEADINGS ── */
.section-title {
font-size: 13px;
font-weight: 600;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–text-dim);
font-family: ‘Space Mono’, monospace;
margin-bottom: 24px;
padding-left: 16px;
border-left: 3px solid var(–accent2);
}

/* ── MIND MAP SVG PANEL ── */
.mindmap-wrapper {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 16px;
overflow: hidden;
position: relative;
}

.mindmap-wrapper svg {
display: block;
width: 100%;
height: auto;
}

/* ── FLOW PANELS ── */
.flow-section { margin-bottom: 48px; }

.flow-title {
font-size: 22px;
font-weight: 700;
margin-bottom: 8px;
display: flex;
align-items: center;
gap: 12px;
}

.flow-title .dot {
width: 12px; height: 12px; border-radius: 50%;
flex-shrink: 0;
}

.flow-subtitle {
color: var(–text-dim);
font-size: 14px;
margin-bottom: 28px;
padding-left: 24px;
}

/* ── PIPELINE STEPS ── */
.pipeline {
display: flex;
flex-direction: column;
gap: 0;
}

.step {
display: grid;
grid-template-columns: 48px 1fr;
gap: 0 20px;
position: relative;
}

.step-connector {
display: flex;
flex-direction: column;
align-items: center;
}

.step-num {
width: 48px; height: 48px;
border-radius: 12px;
display: flex;
align-items: center;
justify-content: center;
font-family: ‘Space Mono’, monospace;
font-weight: 700;
font-size: 14px;
flex-shrink: 0;
position: relative;
z-index: 2;
}

.step-line {
width: 2px;
flex: 1;
min-height: 24px;
background: linear-gradient(to bottom, var(–border), transparent);
margin: 4px 0;
}

.step-body {
padding: 0 0 28px 0;
}

.step-header {
display: flex;
align-items: flex-start;
gap: 12px;
margin-bottom: 12px;
padding-top: 10px;
}

.step-label {
font-size: 16px;
font-weight: 700;
}

.step-tag {
font-family: ‘Space Mono’, monospace;
font-size: 10px;
letter-spacing: 2px;
padding: 3px 10px;
border-radius: 100px;
text-transform: uppercase;
flex-shrink: 0;
margin-top: 3px;
}

.step-desc {
color: var(–text-dim);
font-size: 14px;
line-height: 1.7;
margin-bottom: 12px;
}

.step-detail {
background: var(–surface2);
border: 1px solid var(–border);
border-radius: 10px;
padding: 14px 16px;
}

.step-detail-row {
display: flex;
gap: 10px;
align-items: flex-start;
margin-bottom: 8px;
font-size: 13px;
line-height: 1.5;
}

.step-detail-row:last-child { margin-bottom: 0; }

.step-detail-key {
font-family: ‘Space Mono’, monospace;
font-size: 11px;
color: var(–accent);
white-space: nowrap;
padding-top: 1px;
min-width: 120px;
}

.step-detail-val {
color: var(–text-dim);
}

/* Color themes per phase */
.phase-index .step-num { background: rgba(79,255,176,0.15); color: var(–accent); border: 1px solid rgba(79,255,176,0.3); }
.phase-index .step-tag { background: rgba(79,255,176,0.1); color: var(–accent); border: 1px solid rgba(79,255,176,0.25); }
.phase-index .step-line { background: linear-gradient(to bottom, rgba(79,255,176,0.3), transparent); }

.phase-retrieval .step-num { background: rgba(92,125,255,0.15); color: var(–accent2); border: 1px solid rgba(92,125,255,0.3); }
.phase-retrieval .step-tag { background: rgba(92,125,255,0.1); color: var(–accent2); border: 1px solid rgba(92,125,255,0.25); }
.phase-retrieval .step-line { background: linear-gradient(to bottom, rgba(92,125,255,0.3), transparent); }

.phase-answer .step-num { background: rgba(192,132,252,0.15); color: var(–node-answer); border: 1px solid rgba(192,132,252,0.3); }
.phase-answer .step-tag { background: rgba(192,132,252,0.1); color: var(–node-answer); border: 1px solid rgba(192,132,252,0.25); }
.phase-answer .step-line { background: linear-gradient(to bottom, rgba(192,132,252,0.3), transparent); }

/* ── CODE BLOCK ── */
.code-block {
background: #020409;
border: 1px solid var(–border);
border-radius: 10px;
padding: 16px 20px;
font-family: ‘Space Mono’, monospace;
font-size: 12px;
line-height: 1.8;
overflow-x: auto;
color: #8899cc;
margin-top: 10px;
}

.code-block .k { color: #5c7dff; }
.code-block .s { color: #4fffb0; }
.code-block .c { color: #3d4870; font-style: italic; }
.code-block .n { color: #ffd166; }
.code-block .v { color: #ff9a3c; }

/* ── TREE VISUAL ── */
.tree-visual {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 16px;
padding: 32px;
margin-bottom: 32px;
overflow-x: auto;
}

.tree-visual svg { display: block; margin: 0 auto; }

/* ── COMPARISON TABLE ── */
.compare-table {
width: 100%;
border-collapse: collapse;
border-radius: 12px;
overflow: hidden;
font-size: 14px;
}

.compare-table th {
background: var(–surface2);
color: var(–text-dim);
font-family: ‘Space Mono’, monospace;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
padding: 14px 16px;
text-align: left;
border-bottom: 1px solid var(–border);
}

.compare-table td {
padding: 14px 16px;
border-bottom: 1px solid var(–border);
vertical-align: top;
line-height: 1.6;
color: var(–text-dim);
}

.compare-table td:first-child {
color: var(–text);
font-weight: 600;
white-space: nowrap;
}

.compare-table tr:last-child td { border-bottom: none; }

.compare-table tr:hover td { background: rgba(255,255,255,0.02); }

.tag-bad {
display: inline-block;
background: rgba(255,107,107,0.1);
color: var(–accent3);
border: 1px solid rgba(255,107,107,0.25);
border-radius: 4px;
padding: 2px 8px;
font-size: 12px;
font-family: ‘Space Mono’, monospace;
margin-right: 4px;
}

.tag-good {
display: inline-block;
background: rgba(79,255,176,0.1);
color: var(–accent);
border: 1px solid rgba(79,255,176,0.25);
border-radius: 4px;
padding: 2px 8px;
font-size: 12px;
font-family: ‘Space Mono’, monospace;
margin-right: 4px;
}

/* ── STAT CARDS ── */
.stats-row {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
gap: 16px;
margin-bottom: 40px;
}

.stat-card {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 12px;
padding: 20px;
text-align: center;
}

.stat-num {
font-size: 32px;
font-weight: 800;
font-family: ‘Space Mono’, monospace;
background: linear-gradient(135deg, var(–accent), var(–accent2));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
display: block;
margin-bottom: 6px;
}

.stat-label {
font-size: 12px;
color: var(–text-dim);
font-weight: 600;
letter-spacing: 1px;
text-transform: uppercase;
}

/* ── ANIMATIONS ── */
@keyframes fadeDown {
from { opacity: 0; transform: translateY(-20px); }
to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeUp {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
0%, 100% { opacity: 1; }
50% { opacity: 0.5; }
}

.pulse { animation: pulse 2s infinite; }

/* ── INTERACTIVE TREE ── */
.itree-container {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 16px;
padding: 32px;
overflow-x: auto;
margin-bottom: 32px;
}

.itree-node {
display: flex;
flex-direction: column;
align-items: flex-start;
}

.itree-card {
display: flex;
align-items: center;
gap: 10px;
background: var(–surface2);
border: 1px solid var(–border);
border-radius: 8px;
padding: 10px 14px;
cursor: pointer;
transition: all 0.2s;
min-width: 220px;
position: relative;
}

.itree-card:hover {
border-color: var(–accent2);
transform: translateX(4px);
}

.itree-card.root {
background: linear-gradient(135deg, rgba(79,255,176,0.12), rgba(92,125,255,0.08));
border-color: rgba(79,255,176,0.4);
min-width: 300px;
}

.itree-card.relevant {
border-color: var(–accent);
background: rgba(79,255,176,0.07);
}

.itree-dot {
width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}

.itree-label { font-size: 13px; font-weight: 600; }
.itree-meta { font-size: 11px; font-family: ‘Space Mono’, monospace; color: var(–text-dim); }

.itree-children {
margin-left: 32px;
margin-top: 8px;
padding-left: 16px;
border-left: 1px dashed var(–border);
display: flex;
flex-direction: column;
gap: 8px;
}

.relevance-badge {
position: absolute;
right: 10px;
top: 50%;
transform: translateY(-50%);
font-size: 10px;
font-family: ‘Space Mono’, monospace;
padding: 2px 8px;
border-radius: 100px;
background: rgba(79,255,176,0.15);
color: var(–accent);
border: 1px solid rgba(79,255,176,0.3);
}

.irrelevant-badge {
position: absolute;
right: 10px;
top: 50%;
transform: translateY(-50%);
font-size: 10px;
font-family: ‘Space Mono’, monospace;
padding: 2px 8px;
border-radius: 100px;
background: rgba(255,107,107,0.1);
color: var(–accent3);
border: 1px solid rgba(255,107,107,0.25);
}

/* ── PROMPT REVEAL ── */
.prompt-box {
background: #010208;
border: 1px solid var(–border);
border-radius: 12px;
overflow: hidden;
margin-bottom: 24px;
}

.prompt-header {
background: var(–surface2);
padding: 10px 16px;
display: flex;
align-items: center;
gap: 8px;
border-bottom: 1px solid var(–border);
}

.prompt-header-dot {
width: 8px; height: 8px; border-radius: 50%;
}

.prompt-header-label {
font-family: ‘Space Mono’, monospace;
font-size: 11px;
color: var(–text-dim);
letter-spacing: 1px;
}

.prompt-content {
padding: 20px;
font-family: ‘Space Mono’, monospace;
font-size: 12px;
line-height: 1.9;
color: #8899cc;
}

.prompt-content .highlight { color: var(–accent); }
.prompt-content .highlight2 { color: var(–accent2); }
.prompt-content .highlight3 { color: var(–accent4); }
.prompt-content .comment { color: #3d4870; font-style: italic; }

/* scrollbar */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(–surface); }
::-webkit-scrollbar-thumb { background: var(–border); border-radius: 3px; }

/* responsive */
@media (max-width: 640px) {
.step { grid-template-columns: 40px 1fr; }
.step-detail-key { min-width: 90px; }
header h1 { font-size: 32px; }
}
</style>

</head>
